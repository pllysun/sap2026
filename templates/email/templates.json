[
  {
    "templateKey": "account.registered",
    "templateName": "注册成功 · 欢迎了解软件协会",
    "subject": "{{name}}，欢迎了解软件协会",
    "htmlContent": "<!doctype html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"utf-8\"><title>注册成功 · 欢迎了解软件协会</title>\n<style>@media only screen and (max-width:620px){.outer{padding:20px 10px!important}.inset{padding-left:24px!important;padding-right:24px!important}.headline{font-size:30px!important}.brand{padding-bottom:20px!important}}</style></head>\n<body style=\"margin:0;padding:0;background:#f2f5fa;color:#1a1d2e;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',Arial,sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;color:#f2f5fa;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">账号注册成功，欢迎了解中南林业科技大学软件协会。</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#f2f5fa\"><tr><td align=\"center\" class=\"outer\" style=\"padding:40px 16px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;table-layout:fixed;\">\n<tr><td class=\"brand\" style=\"padding:0 6px 26px;\"><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td width=\"44\" height=\"44\" align=\"center\"><img src=\"https://csuftsap.top/admin/logo.png\" alt=\"软件协会 Logo\" width=\"44\" height=\"44\" style=\"display:block;width:44px;height:44px;border:0;\"></td><td style=\"padding-left:12px;\"><span style=\"font-size:17px;font-weight:700;letter-spacing:2px;color:#27334b;\">软件协会</span><br><span style=\"font-size:10px;line-height:1.8;letter-spacing:2px;color:#6e7591;\">SOFTWARE ASSOCIATION</span></td></tr></table></td></tr>\n<tr><td bgcolor=\"#ffffff\" style=\"background:#ffffff;border:1px solid #e6ebf2;border-radius:16px;overflow:hidden;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"table-layout:fixed;\">\n<tr><td style=\"height:5px;line-height:5px;font-size:1px;background:#14b8a6;background-image:linear-gradient(90deg,#14b8a6,#3b82f6,#8b5cf6);\">&nbsp;</td></tr>\n<tr><td class=\"inset\" style=\"padding:36px 40px 26px;background:#f7fbfe;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">WELCOME / 欢迎了解</p><h1 class=\"headline\" style=\"margin:16px 0;font-size:36px;font-weight:700;letter-spacing:-1px;line-height:1.35;color:#1a2940;\">欢迎了解<br>软件协会。</h1><p style=\"margin:0;font-size:14px;line-height:1.9;color:#626e83;\">很高兴与你相遇，先从这里认识我们。</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:30px 40px 8px;word-break:break-word;\"><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">{{name}}，你好：</p><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">你的账号已注册成功。欢迎了解中南林业科技大学软件协会，很高兴在这里与你相遇。</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#eef7fc;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">认识软件协会</p><p style=\"margin:0;font-size:15px;line-height:1.9;color:#3d4158;white-space:pre-wrap;word-break:break-word;\">{{associationIntro}}</p></td></tr></table><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">愿这次相遇，成为你探索兴趣、认识伙伴的新起点。</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:0 40px 28px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td style=\"border-top:1px solid #e8edf3;padding-top:20px;font-size:12px;line-height:1.9;color:#6e7591;\">若你未注册此账号，请联系协会管理员核实。</td></tr></table></td></tr>\n</table></td></tr>\n<tr><td align=\"center\" style=\"padding:24px 16px 0;font-size:12px;line-height:1.9;color:#6e7591;\"><strong style=\"font-weight:500;color:#555a72;\">万维网连接五大洲，二进制写尽天下事</strong><br>这是一封系统通知邮件，请勿直接回复。<br><span style=\"display:inline-block;margin-top:12px;font-size:12px;color:#555a72;\">中南林业科技大学软件协会</span></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
    "description": "软件协会统一邮件模板。变量及示例参见配套 README 和 samples.json。",
    "enabled": false
  },
  {
    "templateKey": "account.password-code",
    "templateName": "修改密码 · 安全验证码",
    "subject": "软件协会｜修改密码验证码",
    "htmlContent": "<!doctype html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"utf-8\"><title>修改密码 · 安全验证码</title>\n<style>@media only screen and (max-width:620px){.outer{padding:20px 10px!important}.inset{padding-left:24px!important;padding-right:24px!important}.brand{padding-bottom:20px!important}}</style></head>\n<body style=\"margin:0;padding:0;background:#f2f5fa;color:#1a1d2e;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',Arial,sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;color:#f2f5fa;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">密码重置验证码，请在操作页面输入。</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#f2f5fa\"><tr><td align=\"center\" class=\"outer\" style=\"padding:40px 16px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;table-layout:fixed;\">\n<tr><td class=\"brand\" style=\"padding:0 6px 26px;\"><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td width=\"44\" height=\"44\" align=\"center\"><img src=\"https://csuftsap.top/admin/logo.png\" alt=\"软件协会 Logo\" width=\"44\" height=\"44\" style=\"display:block;width:44px;height:44px;border:0;\"></td><td style=\"padding-left:12px;\"><span style=\"font-size:17px;font-weight:700;letter-spacing:2px;color:#27334b;\">软件协会</span><br><span style=\"font-size:10px;line-height:1.8;letter-spacing:2px;color:#6e7591;\">SOFTWARE ASSOCIATION</span></td></tr></table></td></tr>\n<tr><td bgcolor=\"#ffffff\" style=\"background:#ffffff;border:1px solid #e6ebf2;border-radius:16px;overflow:hidden;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"table-layout:fixed;\">\n<tr><td style=\"height:5px;line-height:5px;font-size:1px;background:#14b8a6;background-image:linear-gradient(90deg,#14b8a6,#3b82f6,#8b5cf6);\">&nbsp;</td></tr>\n<tr><td class=\"inset\" style=\"padding:36px 40px 26px;background:#f7fbfe;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">SECURITY / 账号安全</p><p style=\"margin:0;font-size:14px;line-height:1.9;color:#626e83;\">请在操作页面输入下方验证码。</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:30px 40px 8px;word-break:break-word;\"><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">{{name}}，你好：</p><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">我们收到了账号 {{account}} 的密码修改申请。请使用下方验证码完成验证。</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#eef7fc;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">本次操作验证码</p><p style=\"margin:8px 0 12px;font-family:Consolas,'Courier New',monospace;font-size:34px;font-weight:700;letter-spacing:7px;line-height:1.5;color:#125879;\">{{code}}</p><p style=\"margin:0;font-size:13px;line-height:1.8;color:#555a72;\">验证码在 <strong>{{expiresInMinutes}} 分钟</strong>内有效。</p></td></tr></table><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">请勿向任何人透露验证码，协会工作人员也不会向你索取验证码。</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#f5f6fa;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">不是本人操作？</p><p style=\"margin:0;font-size:14px;line-height:1.9;color:#555a72;\">请忽略此邮件，不要提供验证码。若你反复收到非本人发起的验证邮件，请联系协会管理员。</p></td></tr></table></td></tr>\n<tr><td class=\"inset\" style=\"padding:0 40px 28px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td style=\"border-top:1px solid #e8edf3;padding-top:20px;font-size:12px;line-height:1.9;color:#6e7591;\">此邮件仅用于验证密码修改操作，不代表密码已经修改成功。</td></tr></table></td></tr>\n</table></td></tr>\n<tr><td align=\"center\" style=\"padding:24px 16px 0;font-size:12px;line-height:1.9;color:#6e7591;\"><strong style=\"font-weight:500;color:#555a72;\">万维网连接五大洲，二进制写尽天下事</strong><br>这是一封系统通知邮件，请勿直接回复。<br><span style=\"display:inline-block;margin-top:12px;font-size:12px;color:#555a72;\">中南林业科技大学软件协会</span></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
    "description": "软件协会统一邮件模板。变量及示例参见配套 README 和 samples.json。",
    "enabled": false
  },
  {
    "templateKey": "member.upgraded",
    "templateName": "加入协会 · 共同成长与进步",
    "subject": "{{name}}，欢迎加入软件协会",
    "htmlContent": "<!doctype html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"utf-8\"><title>加入协会 · 共同成长与进步</title>\n<style>@media only screen and (max-width:620px){.outer{padding:20px 10px!important}.inset{padding-left:24px!important;padding-right:24px!important}.headline{font-size:30px!important}.brand{padding-bottom:20px!important}}</style></head>\n<body style=\"margin:0;padding:0;background:#f2f5fa;color:#1a1d2e;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',Arial,sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;color:#f2f5fa;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">欢迎成为软件协会的一员，让我们共同成长、共同进步。</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#f2f5fa\"><tr><td align=\"center\" class=\"outer\" style=\"padding:40px 16px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;table-layout:fixed;\">\n<tr><td class=\"brand\" style=\"padding:0 6px 26px;\"><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td width=\"44\" height=\"44\" align=\"center\"><img src=\"https://csuftsap.top/admin/logo.png\" alt=\"软件协会 Logo\" width=\"44\" height=\"44\" style=\"display:block;width:44px;height:44px;border:0;\"></td><td style=\"padding-left:12px;\"><span style=\"font-size:17px;font-weight:700;letter-spacing:2px;color:#27334b;\">软件协会</span><br><span style=\"font-size:10px;line-height:1.8;letter-spacing:2px;color:#6e7591;\">SOFTWARE ASSOCIATION</span></td></tr></table></td></tr>\n<tr><td bgcolor=\"#ffffff\" style=\"background:#ffffff;border:1px solid #e6ebf2;border-radius:16px;overflow:hidden;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"table-layout:fixed;\">\n<tr><td style=\"height:5px;line-height:5px;font-size:1px;background:#14b8a6;background-image:linear-gradient(90deg,#14b8a6,#3b82f6,#8b5cf6);\">&nbsp;</td></tr>\n<tr><td class=\"inset\" style=\"padding:36px 40px 26px;background:#f7fbfe;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">TOGETHER / 欢迎加入</p><h1 class=\"headline\" style=\"margin:16px 0;font-size:36px;font-weight:700;letter-spacing:-1px;line-height:1.35;color:#1a2940;\">欢迎加入<br>软件协会。</h1><p style=\"margin:0;font-size:14px;line-height:1.9;color:#626e83;\">共同成长，共同进步。</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:30px 40px 8px;word-break:break-word;\"><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">{{name}}，你好：</p><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">欢迎正式加入中南林业科技大学软件协会！很高兴从今天起，与你成为并肩前行的伙伴。</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#eef7fc;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">一起，让热爱成为成长的力量</p><p style=\"margin:0;font-size:21px;line-height:1.8;font-weight:700;color:#1a2940;\">共同成长，共同进步。</p></td></tr></table><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">在这里，不必独自面对学习中的困惑。期待与你交流思路、分享收获、动手实践，在互相帮助中一点点进步。</p><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">愿你在协会找到志同道合的朋友，也遇见不断突破的自己。未来的日子，让我们一起加油！</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:0 40px 28px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td style=\"border-top:1px solid #e8edf3;padding-top:20px;font-size:12px;line-height:1.9;color:#6e7591;\">如需了解协会活动或参与方式，欢迎联系协会管理员。</td></tr></table></td></tr>\n</table></td></tr>\n<tr><td align=\"center\" style=\"padding:24px 16px 0;font-size:12px;line-height:1.9;color:#6e7591;\"><strong style=\"font-weight:500;color:#555a72;\">万维网连接五大洲，二进制写尽天下事</strong><br>这是一封系统通知邮件，请勿直接回复。<br><span style=\"display:inline-block;margin-top:12px;font-size:12px;color:#555a72;\">中南林业科技大学软件协会</span></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
    "description": "软件协会统一邮件模板。变量及示例参见配套 README 和 samples.json。",
    "enabled": false
  },
  {
    "templateKey": "app.issue-replied",
    "templateName": "问题反馈 · 管理员回复提醒",
    "subject": "你的问题有新回复｜{{issueTitle}}",
    "htmlContent": "<!doctype html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"utf-8\"><title>问题反馈 · 管理员回复提醒</title>\n<style>@media only screen and (max-width:620px){.outer{padding:20px 10px!important}.inset{padding-left:24px!important;padding-right:24px!important}.headline{font-size:30px!important}.brand{padding-bottom:20px!important}}</style></head>\n<body style=\"margin:0;padding:0;background:#f2f5fa;color:#1a1d2e;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',Arial,sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;color:#f2f5fa;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">你在软协课表提交的问题收到了管理员回复，请查看最新进展。</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#f2f5fa\"><tr><td align=\"center\" class=\"outer\" style=\"padding:40px 16px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;table-layout:fixed;\">\n<tr><td class=\"brand\" style=\"padding:0 6px 26px;\"><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td width=\"44\" height=\"44\" align=\"center\"><img src=\"https://csuftsap.top/admin/logo.png\" alt=\"软件协会 Logo\" width=\"44\" height=\"44\" style=\"display:block;width:44px;height:44px;border:0;\"></td><td style=\"padding-left:12px;\"><span style=\"font-size:17px;font-weight:700;letter-spacing:2px;color:#27334b;\">软件协会</span><br><span style=\"font-size:10px;line-height:1.8;letter-spacing:2px;color:#6e7591;\">SOFTWARE ASSOCIATION</span></td></tr></table></td></tr>\n<tr><td bgcolor=\"#ffffff\" style=\"background:#ffffff;border:1px solid #e6ebf2;border-radius:16px;overflow:hidden;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"table-layout:fixed;\">\n<tr><td style=\"height:5px;line-height:5px;font-size:1px;background:#14b8a6;background-image:linear-gradient(90deg,#14b8a6,#3b82f6,#8b5cf6);\">&nbsp;</td></tr>\n<tr><td class=\"inset\" style=\"padding:36px 40px 26px;background:#f7fbfe;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">FEEDBACK / 问题跟进</p><h1 class=\"headline\" style=\"margin:16px 0;font-size:36px;font-weight:700;letter-spacing:-1px;line-height:1.35;color:#1a2940;\">你的反馈，<br>有新进展。</h1><p style=\"margin:0;font-size:14px;line-height:1.9;color:#626e83;\">管理员已回复，邀你继续关注。</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:30px 40px 8px;word-break:break-word;\"><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">{{name}}，你好：</p><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">你在软协课表提交的问题收到了新回复。谢谢你愿意把使用中的问题告诉我们。</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#eef7fc;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">反馈 #{{issueId}}</p><p style=\"margin:0;font-size:19px;font-weight:700;line-height:1.7;color:#1a1d2e;overflow-wrap:anywhere;word-break:break-word;\">{{issueTitle}}</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td width=\"82\" valign=\"top\" style=\"padding:7px 8px 7px 0;color:#6e7591;font-size:13px;line-height:1.8;\">当前状态</td><td style=\"padding:7px 0;font-size:14px;line-height:1.8;color:#2d3142;word-break:break-word;\">{{issueStatus}}</td></tr></table></td></tr></table><p style=\"margin:0 0 12px;color:#2d3142;font-size:14px;font-weight:700;\">{{adminName}} 的回复</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:0 0 18px;\"><tr><td style=\"border-left:3px solid #14b8a6;padding:14px 18px;background:#f7f8fc;font-size:15px;line-height:1.9;color:#3d4158;white-space:pre-wrap;word-break:break-word;\">{{replyContent}}</td></tr></table><p style=\"margin:0 0 20px;font-size:12px;color:#6e7591;line-height:1.8;\">回复时间：{{repliedAt}}</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#eef7fc;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">在软协课表中查看</p><p style=\"margin:0;font-size:15px;line-height:2;color:#1a2940;\"><strong>打开软协课表 App</strong><br>进入「我的」→「意见反馈」<br>找到上述问题，查看完整回复与处理状态。</p></td></tr></table><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">如需补充信息，请在 App 内按问题页面提示操作。</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:0 40px 28px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td style=\"border-top:1px solid #e8edf3;padding-top:20px;font-size:12px;line-height:1.9;color:#6e7591;\">请在问题详情页跟进，此提醒邮件不代替问题处理结果。</td></tr></table></td></tr>\n</table></td></tr>\n<tr><td align=\"center\" style=\"padding:24px 16px 0;font-size:12px;line-height:1.9;color:#6e7591;\"><strong style=\"font-weight:500;color:#555a72;\">万维网连接五大洲，二进制写尽天下事</strong><br>这是一封系统通知邮件，请勿直接回复。<br><span style=\"display:inline-block;margin-top:12px;font-size:12px;color:#555a72;\">中南林业科技大学软件协会</span></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
    "description": "软件协会统一邮件模板。变量及示例参见配套 README 和 samples.json。",
    "enabled": false
  },
  {
    "templateKey": "study.review-reminder",
    "templateName": "学习小队 · 提醒管理员评分",
    "subject": "待评分提醒｜{{teamName}} · {{taskTitle}}",
    "htmlContent": "<!doctype html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"utf-8\"><title>学习小队 · 提醒管理员评分</title>\n<style>@media only screen and (max-width:620px){.outer{padding:20px 10px!important}.inset{padding-left:24px!important;padding-right:24px!important}.headline{font-size:30px!important}.brand{padding-bottom:20px!important}}</style></head>\n<body style=\"margin:0;padding:0;background:#f2f5fa;color:#1a1d2e;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',Arial,sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;color:#f2f5fa;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">学习小队有任务等待评分，请负责管理员查看并完成评阅。</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#f2f5fa\"><tr><td align=\"center\" class=\"outer\" style=\"padding:40px 16px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;table-layout:fixed;\">\n<tr><td class=\"brand\" style=\"padding:0 6px 26px;\"><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td width=\"44\" height=\"44\" align=\"center\"><img src=\"https://csuftsap.top/admin/logo.png\" alt=\"软件协会 Logo\" width=\"44\" height=\"44\" style=\"display:block;width:44px;height:44px;border:0;\"></td><td style=\"padding-left:12px;\"><span style=\"font-size:17px;font-weight:700;letter-spacing:2px;color:#27334b;\">软件协会</span><br><span style=\"font-size:10px;line-height:1.8;letter-spacing:2px;color:#6e7591;\">SOFTWARE ASSOCIATION</span></td></tr></table></td></tr>\n<tr><td bgcolor=\"#ffffff\" style=\"background:#ffffff;border:1px solid #e6ebf2;border-radius:16px;overflow:hidden;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"table-layout:fixed;\">\n<tr><td style=\"height:5px;line-height:5px;font-size:1px;background:#14b8a6;background-image:linear-gradient(90deg,#14b8a6,#3b82f6,#8b5cf6);\">&nbsp;</td></tr>\n<tr><td class=\"inset\" style=\"padding:36px 40px 26px;background:#f7fbfe;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">LEARNING / 待办提醒</p><h1 class=\"headline\" style=\"margin:16px 0;font-size:36px;font-weight:700;letter-spacing:-1px;line-height:1.35;color:#1a2940;\">同学已提交，<br>等你来点评。</h1><p style=\"margin:0;font-size:14px;line-height:1.9;color:#626e83;\">一次及时的反馈，能让下一步更清晰。</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:30px 40px 8px;word-break:break-word;\"><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">{{adminName}}，你好：</p><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">你负责的学习小队有任务等待评分。请查看同学的提交内容，完成评分并留下反馈，帮助大家继续改进。</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#eef7fc;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">待处理的学习任务</p><p style=\"margin:0;font-size:19px;font-weight:700;line-height:1.7;color:#1a1d2e;overflow-wrap:anywhere;word-break:break-word;\">{{taskTitle}}</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td width=\"82\" valign=\"top\" style=\"padding:7px 8px 7px 0;color:#6e7591;font-size:13px;line-height:1.8;\">学习小队</td><td style=\"padding:7px 0;font-size:14px;line-height:1.8;color:#2d3142;word-break:break-word;\">{{teamName}}</td></tr><tr><td width=\"82\" valign=\"top\" style=\"padding:7px 8px 7px 0;color:#6e7591;font-size:13px;line-height:1.8;\">待评分</td><td style=\"padding:7px 0;font-size:14px;line-height:1.8;color:#2d3142;word-break:break-word;\">{{pendingCount}} 份提交</td></tr><tr><td width=\"82\" valign=\"top\" style=\"padding:7px 8px 7px 0;color:#6e7591;font-size:13px;line-height:1.8;\">任务截止</td><td style=\"padding:7px 0;font-size:14px;line-height:1.8;color:#2d3142;word-break:break-word;\">{{taskDeadline}}</td></tr><tr><td width=\"82\" valign=\"top\" style=\"padding:7px 8px 7px 0;color:#6e7591;font-size:13px;line-height:1.8;\">提醒时间</td><td style=\"padding:7px 0;font-size:14px;line-height:1.8;color:#2d3142;word-break:break-word;\">{{remindedAt}}</td></tr></table></td></tr></table><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">进入任务页面后，请以最新待评分列表为准；若已全部处理，可忽略此提醒。</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:28px 0 18px;\"><tr><td bgcolor=\"#167da8\" style=\"background:#167da8;border-radius:8px;mso-padding-alt:14px 26px;\"><a href=\"{{reviewUrl}}\" style=\"display:inline-block;padding:14px 26px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;line-height:1.5;\">前往评分&nbsp; →</a></td></tr></table><p style=\"margin:0 0 24px;font-size:12px;line-height:1.8;color:#6e7591;\">按钮无法打开？复制此链接到浏览器：<br><a href=\"{{reviewUrl}}\" style=\"color:#167da8;text-decoration:underline;word-break:break-all;\">{{reviewUrl}}</a></p></td></tr>\n<tr><td class=\"inset\" style=\"padding:0 40px 28px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td style=\"border-top:1px solid #e8edf3;padding-top:20px;font-size:12px;line-height:1.9;color:#6e7591;\">此提醒面向任务负责管理员；请在登录后查看提交详情，勿转发含个人信息的内容。</td></tr></table></td></tr>\n</table></td></tr>\n<tr><td align=\"center\" style=\"padding:24px 16px 0;font-size:12px;line-height:1.9;color:#6e7591;\"><strong style=\"font-weight:500;color:#555a72;\">万维网连接五大洲，二进制写尽天下事</strong><br>这是一封系统通知邮件，请勿直接回复。<br><span style=\"display:inline-block;margin-top:12px;font-size:12px;color:#555a72;\">中南林业科技大学软件协会</span></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
    "description": "软件协会统一邮件模板。变量及示例参见配套 README 和 samples.json。",
    "enabled": false
  },
  {
    "templateKey": "app.registration-code",
    "templateName": "App 注册 · QQ 邮箱验证码",
    "subject": "软件协会｜App 注册邮箱验证码",
    "htmlContent": "<!doctype html>\n<html lang=\"zh-CN\">\n<head><meta charset=\"utf-8\"><title>App 注册 · QQ 邮箱验证码</title>\n<style>@media only screen and (max-width:620px){.outer{padding:20px 10px!important}.inset{padding-left:24px!important;padding-right:24px!important}.brand{padding-bottom:20px!important}}</style></head>\n<body style=\"margin:0;padding:0;background:#f2f5fa;color:#1a1d2e;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei','PingFang SC',Arial,sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;color:#f2f5fa;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">App 注册邮箱验证码，请返回软协课表 App 输入。</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" bgcolor=\"#f2f5fa\"><tr><td align=\"center\" class=\"outer\" style=\"padding:40px 16px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px;table-layout:fixed;\">\n<tr><td class=\"brand\" style=\"padding:0 6px 26px;\"><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td width=\"44\" height=\"44\" align=\"center\"><img src=\"https://csuftsap.top/admin/logo.png\" alt=\"软件协会 Logo\" width=\"44\" height=\"44\" style=\"display:block;width:44px;height:44px;border:0;\"></td><td style=\"padding-left:12px;\"><span style=\"font-size:17px;font-weight:700;letter-spacing:2px;color:#27334b;\">软件协会</span><br><span style=\"font-size:10px;line-height:1.8;letter-spacing:2px;color:#6e7591;\">SOFTWARE ASSOCIATION</span></td></tr></table></td></tr>\n<tr><td bgcolor=\"#ffffff\" style=\"background:#ffffff;border:1px solid #e6ebf2;border-radius:16px;overflow:hidden;\">\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"table-layout:fixed;\">\n<tr><td style=\"height:5px;line-height:5px;font-size:1px;background:#14b8a6;background-image:linear-gradient(90deg,#14b8a6,#3b82f6,#8b5cf6);\">&nbsp;</td></tr>\n<tr><td class=\"inset\" style=\"padding:36px 40px 26px;background:#f7fbfe;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">SECURITY / 账号安全</p><p style=\"margin:0;font-size:14px;line-height:1.9;color:#626e83;\">请返回软协课表 App，输入下方邮箱验证码。</p></td></tr>\n<tr><td class=\"inset\" style=\"padding:30px 40px 8px;word-break:break-word;\"><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">{{name}}，你好：</p><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">我们收到了学号 {{account}} 的 App 注册申请。请使用下方验证码验证 QQ 邮箱 {{email}}，完成账号注册。</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#eef7fc;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">本次操作验证码</p><p style=\"margin:8px 0 12px;font-family:Consolas,'Courier New',monospace;font-size:34px;font-weight:700;letter-spacing:7px;line-height:1.5;color:#125879;\">{{code}}</p><p style=\"margin:0;font-size:13px;line-height:1.8;color:#555a72;\">验证码在 <strong>{{expiresInMinutes}} 分钟</strong>内有效。</p></td></tr></table><p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#555a72;\">请勿向任何人透露验证码，协会工作人员也不会向你索取验证码。</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:8px 0 24px;background:#f5f6fa;border-radius:12px;\"><tr><td style=\"padding:22px 24px;\"><p style=\"margin:0 0 10px;font-size:12px;line-height:1.6;letter-spacing:2px;color:#087f8c;font-weight:700;\">不是本人操作？</p><p style=\"margin:0;font-size:14px;line-height:1.9;color:#555a72;\">请忽略此邮件，不要提供验证码。若你反复收到非本人发起的验证邮件，请联系协会管理员。</p></td></tr></table></td></tr>\n<tr><td class=\"inset\" style=\"padding:0 40px 28px;\"><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td style=\"border-top:1px solid #e8edf3;padding-top:20px;font-size:12px;line-height:1.9;color:#6e7591;\">此邮件仅用于验证 App 注册的 QQ 邮箱，输入验证码并提交后才会创建账号；如果不是本人申请，请忽略。</td></tr></table></td></tr>\n</table></td></tr>\n<tr><td align=\"center\" style=\"padding:24px 16px 0;font-size:12px;line-height:1.9;color:#6e7591;\"><strong style=\"font-weight:500;color:#555a72;\">万维网连接五大洲，二进制写尽天下事</strong><br>这是一封系统通知邮件，请勿直接回复。<br><span style=\"display:inline-block;margin-top:12px;font-size:12px;color:#555a72;\">中南林业科技大学软件协会</span></td></tr>\n</table><!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>\n",
    "description": "手机端注册验证 QQ 邮箱，Web 注册不受影响。",
    "enabled": true,
    "eventKey": "APP_REGISTRATION_CODE"
  }
]
