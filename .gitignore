# ==============================================
# SAP 项目根目录 .gitignore
# ==============================================

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Node.js =====
**/node_modules/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Java / Maven =====
**/target/
*.class
*.jar
!.mvn/wrapper/*.jar
*.war

# ===== 前端构建产物 =====
sap-admin/dist/
sap-user/dist/
**/dist-ssr/

# ===== 敏感配置文件 =====
# 真实环境配置包含数据库密码等信息，不提交到仓库
# 请复制 .example 文件并重命名后使用
sap-backend/src/main/resources/application-dev.yml
sap-backend/src/main/resources/application-prod.yml
# Docker 生产环境变量（含 JW_AES_KEY/MySQL 密码），仅保留 .env.example
docker/.env
.env
ops/*.local.env
ops/*.local.md
ops/*-key.local
# 安卓签名密钥
**/keystore.properties
**/*.jks
**/*.keystore
# 本机 Gradle 状态（此处可能是指向工作机缓存的软链接）
sap-android/.gradle

# ===== 打包产物（APK 输出目录）=====
/release/

# 本地渲染的邮件预览可能含测试收件人信息
templates/email/preview.html

# ===== 日志 =====
*.log
logs/

# ===== 测试 / 工具脚本 =====
**/test-cos-integration.ps1
**/query_old_db.js

# ===== Docker 数据 =====
**/data/
**/uploads/

# Android 的 data 是源码分层，不是 Docker 运行数据
!sap-android/app/src/main/java/edu/csuft/sap/data/
!sap-android/app/src/main/java/edu/csuft/sap/data/**

# ===== Python（OCR sidecar）=====
# 虚拟环境/字节码体积大且平台相关，绝不入库；靠 requirements.txt 重建
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*.egg-info/

# ===== Gemini AI =====
.gemini/

# ===== App 发版产物（APK 体积大，不入库；按版本归档在本地/分发渠道）=====
/release/

# ===== OJ 本地核验资料与未公开比赛内容 =====
# 运行报告可能包含线上账户/部署信息；公开仓库仅保留源码和发布说明。
/ops/judger/*.json
/ops/judger/*.jsonl
/ops/security-audit/**/*.json
# 题解源快照、编写中间资料和完整清单均留在本地。
/ops/judger/solutions/source-problems/
/ops/judger/solutions/authoring/
/ops/judger/solutions/*.json
# 比赛发布前不向公开仓库上传题面、参考代码、测试集或题解。
/ops/judger/problem-packs/contest-original/
/ops/judger/solutions/documents/contest-original-*.json
/ops/judger/PROBLEMSETS-RELEASE-1511.md
