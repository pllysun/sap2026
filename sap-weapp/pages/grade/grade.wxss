/* 成绩页私有样式（分段控件/弹层走全局 app.wxss + CSS 变量） */

/* 同步按钮：App 刷新图标 + 文字 */
.sync-btn { display: flex; align-items: center; }
.sync-btn .ic-refresh {
  width: 28rpx; height: 28rpx; margin-right: 8rpx;
  background-repeat: no-repeat; background-position: center; background-size: contain;
  background-image: url("data:image/svg+xml;base64,"); }

/* 卡片标题 */
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* ===== 成绩概览 ===== */
.ov-top { display: flex; }
.ov-main { flex: 1; display: flex; flex-direction: column; align-items: center; }
.ov-num { font-size: 48rpx; font-weight: 700; color: var(--accent); line-height: 1.2; }
.ov-lab { font-size: 23rpx; color: var(--text-tertiary); margin-top: 6rpx; }
.ov-hr { margin: 24rpx 0; }
.ov-grid { display: flex; flex-wrap: wrap; }
.ov-cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.oc-k { font-size: 22rpx; color: var(--text-tertiary); }
.oc-v { font-size: 30rpx; font-weight: 600; margin-top: 6rpx; }
.oc-danger { color: var(--danger); }

/* ===== 分数段分布 ===== */
.band-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.band-row:last-child { margin-bottom: 0; }
.band-lab { width: 120rpx; flex: 0 0 120rpx; font-size: 24rpx; color: var(--text-secondary); }
.band-track {
  flex: 1;
  height: 24rpx;
  background: var(--surface-muted);
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.band-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 12rpx;
  min-width: 2rpx;
  transition: width 0.3s ease;
}
.band-fill.danger { background: var(--danger); }
.band-cnt { width: 50rpx; flex: 0 0 50rpx; text-align: right; font-size: 24rpx; color: var(--text-secondary); }

/* ===== 成绩列表（对齐 App：汇总卡 + 学期标题 + 逐课白卡） ===== */
.stat-card { display: flex; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-v { font-size: 44rpx; font-weight: 600; color: var(--accent); line-height: 1.2; }
.stat-k { font-size: 24rpx; color: var(--text-tertiary); margin-top: 6rpx; }

.term-head {
  font-size: 26rpx; font-weight: 500; color: var(--accent);
  margin: 16rpx 32rpx 8rpx;
}
.grade-card { display: flex; align-items: center; padding: 24rpx 28rpx; }
.gc-left { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.gc-name { font-size: 30rpx; font-weight: 500; }
.gc-sub { font-size: 24rpx; color: var(--text-secondary); margin-top: 6rpx; }
.gc-score { flex: 0 0 auto; margin-left: 20rpx; font-size: 40rpx; font-weight: 600; color: var(--accent); }
.gc-score.fail { color: var(--danger); }

/* ===== 学期选择条 ===== */
.term-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 16rpx;
  padding: 18rpx 28rpx;
  background: var(--surface);
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.tp-caret { color: var(--text-tertiary); font-size: 24rpx; }

/* ===== 考试卡（对齐 App ExamCard：色点 + 课程名 + 信息行） ===== */
.exam-head { display: flex; align-items: center; margin-bottom: 8rpx; }
.exam-dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 14rpx; flex: 0 0 auto; }
.exam-name { font-size: 32rpx; font-weight: 500; }
.exam-row { display: flex; padding: 8rpx 0; font-size: 26rpx; }
.ex-k { width: 96rpx; flex: 0 0 96rpx; color: var(--text-secondary); }
.ex-v { flex: 1; color: var(--text-primary); }

/* ===== 评教 ===== */
.eval-auto-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: var(--surface);
}
.eval-auto-title { display: block; font-size: 30rpx; font-weight: 600; }
.eval-auto-desc {
  display: block; margin-top: 8rpx;
  color: var(--text-secondary); font-size: 24rpx; line-height: 1.5;
}
.auto-btn { margin: 20rpx 0 0; }
.eval-top { display: flex; align-items: center; justify-content: space-between; }
.eval-main { min-width: 0; display: flex; flex-direction: column; }
.eval-course { font-size: 30rpx; font-weight: 600; }
.eval-teacher { margin-top: 5rpx; font-size: 24rpx; color: var(--text-secondary); }
.eval-status { font-size: 26rpx; font-weight: 600; }
.eval-status.done { color: var(--accent); }
.eval-status.todo { color: var(--text-tertiary); }
.eval-sub { display: flex; align-items: center; margin-top: 10rpx; }
.eval-type {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--surface-muted);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
}
.eval-manual-btn {
  margin: 22rpx 0 0;
  height: 68rpx; line-height: 68rpx;
  border: 1rpx solid var(--accent); border-radius: 12rpx;
  background: transparent; color: var(--accent);
  font-size: 26rpx; font-weight: 500;
}
.eval-manual-btn::after { border: 0; }

/* ===== 手动评价表 ===== */
.eval-form-sheet { max-height: 92vh; padding-bottom: calc(22rpx + env(safe-area-inset-bottom)); }
.eval-form-heading { min-width: 0; display: flex; flex-direction: column; }
.eval-form-teacher { margin-top: 4rpx; font-size: 23rpx; font-weight: 400; color: var(--text-secondary); }
.eval-score-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 20rpx; border-radius: 14rpx; background: var(--surface-muted);
  color: var(--text-secondary); font-size: 25rpx;
}
.eval-score-value { color: var(--accent); font-size: 30rpx; font-weight: 700; }
.eval-rule-tip {
  margin-top: 12rpx; padding: 14rpx 18rpx; border-radius: 12rpx;
  background: rgba(245, 158, 11, .12); color: #B56B00;
  font-size: 22rpx; line-height: 1.5;
}
.eval-form-scroll { height: 58vh; margin-top: 12rpx; }
.eval-question { padding: 22rpx 4rpx; border-bottom: 1rpx solid var(--hairline); }
.eval-section { display: block; margin-bottom: 7rpx; color: var(--accent); font-size: 22rpx; }
.eval-question-title { font-size: 27rpx; line-height: 1.55; color: var(--text-primary); }
.required { color: var(--danger); }
.eval-remark { display: block; margin-top: 6rpx; color: var(--text-tertiary); font-size: 22rpx; }
.score-input-wrap { display: flex; align-items: center; margin-top: 14rpx; }
.eval-input {
  box-sizing: border-box; min-height: 72rpx; padding: 14rpx 18rpx;
  border: 1rpx solid var(--hairline); border-radius: 12rpx;
  background: var(--surface-muted); font-size: 27rpx;
}
.score-input-wrap .eval-input { width: 220rpx; }
.score-unit { margin-left: 14rpx; color: var(--text-secondary); font-size: 24rpx; }
.eval-textarea {
  box-sizing: border-box; width: 100%; min-height: 150rpx; margin-top: 14rpx;
  padding: 16rpx 18rpx; border: 1rpx solid var(--hairline); border-radius: 12rpx;
  background: var(--surface-muted); font-size: 26rpx; line-height: 1.5;
}
.eval-option { display: flex; align-items: center; padding: 13rpx 4rpx; font-size: 25rpx; }
.eval-option radio, .eval-option checkbox { transform: scale(.85); margin-right: 6rpx; }
.eval-submit-btn { margin: 18rpx 0 0; }

/* ===== 弹层滚动 ===== */
.sheet-scroll { max-height: 56vh; }

/* ===== 评教结果行 ===== */
.res-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.res-left { display: flex; flex-direction: column; }
.res-course { font-size: 28rpx; font-weight: 500; }
.res-teacher { font-size: 23rpx; color: var(--text-secondary); margin-top: 3rpx; }
.res-flag { font-size: 26rpx; max-width: 320rpx; text-align: right; }
.res-flag.ok { color: var(--accent); }
.res-flag.bad { color: var(--danger); }
