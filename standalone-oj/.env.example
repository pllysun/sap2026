# Reference only. Run python3 tools/init.py for private random credentials.
LUME_IMAGE=pllysun/lume:1.1.1
LUME_SERVER_IMAGE=pllysun/lume-server:1.1.1
LUME_WORKER_IMAGE=pllysun/lume-worker:1.1.1
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
DB_URL=jdbc:mysql://mysql.example.com:3306/oj?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=VERIFY_IDENTITY
DB_USER=oj
DB_PASSWORD=replace-with-private-password
MYSQL_ROOT_PASSWORD=replace-only-if-using-mysql-profile
OJ_ADMIN_ACCOUNT=admin
OJ_ADMIN_PASSWORD=replace-with-private-bootstrap-password
JUDGER_BUILTIN_ENABLED=true
NODE_CGROUP_PREFIX=lume-node
APP_HEAP_MB=1024
NODE_CONCURRENCY=2
NODE_CPU=2
NODE_MEMORY_MB=1280
S3_ENABLED=false
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=sap-oj-private
S3_ACCESS_KEY=replace-with-scoped-access-key
S3_SECRET_KEY=replace-with-private-secret-key
S3_PATH_STYLE=true
S3_CREATE_BUCKET=false
RUSTFS_IMAGE=rustfs/rustfs:1.0.1
RUSTFS_CONSOLE_PORT=9001
