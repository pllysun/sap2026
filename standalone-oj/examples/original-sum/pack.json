  "references": {
    "c": {
      "STDIO": "#include <stdio.h>\nint main(void) {\n    // 使用 long long，统一承载读入的整数及其和。\n    long long a, b;\n    if (scanf(\"%lld %lld\", &a, &b) != 2) return 0;\n    // 两个有符号整数直接相加，负数和零无需特殊判断。\n    long long sum = a + b;\n    // 输出整数并换行，不附加说明文字。\n    printf(\"%lld\\n\", sum);\n    return 0;\n}\n"
    },
    "cpp": {
      "STDIO": "#include <iostream>\nint main() {\n    // 用 long long 读取整数，预留足够的取值范围。\n    long long a, b;\n    if (!(std::cin >> a >> b)) return 0;\n    // 加法对正数、负数和零都遵循同一条规则。\n    long long sum = a + b;\n    // 按题目协议只输出答案和一个换行。\n    std::cout << sum << '\\n';\n    return 0;\n}\n"
    },
    "java": {
      "STDIO": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        // Scanner 按空白分隔读取输入，换行和空格都可作为分隔符。\n        Scanner input = new Scanner(System.in);\n        long a = input.nextLong();\n        long b = input.nextLong();\n        // long 可承载输入值及它们的和，避免类型范围造成误判。\n        long sum = a + b;\n        // 标准输出中只放答案，println 自动追加换行。\n        System.out.println(sum);\n    }\n}\n"
    },
    "python": {
      "STDIO": "import sys\n# 按空白切分标准输入，所以末尾换行不会影响读取。\nvalues = sys.stdin.buffer.read().split()\na, b = map(int, values)\n# Python 整数支持负数；这里直接计算两个整数的和。\nsum_value = a + b\n# print 自动换行，不输出提示信息。\nprint(sum_value)\n"
    },
    "rust": {
      "STDIO": "use std::io::{self, Read};\nfn main() {\n    // 一次读取输入，并按空白获取两个整数。\n    let mut input = String::new();\n    io::stdin().read_to_string(&mut input).unwrap();\n    let mut values = input.split_whitespace();\n    let a: i64 = values.next().unwrap().parse().unwrap();\n    let b: i64 = values.next().unwrap().parse().unwrap();\n    // i64 保留正负号和足够的取值范围。\n    let sum = a + b;\n    // 只输出结果，println! 自动追加换行。\n    println!(\"{}\", sum);\n}\n"
    }
  }
