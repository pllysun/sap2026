      "STDIO": "#include <algorithm>\n#include <iostream>\n#include <string>\n#include <vector>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, m;\n    cin >> n >> m;\n    vector<string> grid(n);\n    for (string& row : grid) {\n        cin >> row;\n    }\n    for (int row = 0; row < n; ++row) {\n        for (int col = 0; col < m; ++col) {\n            if (grid[row][col] == '#') {\n                cout << '#';\n                continue;\n            }\n            int count = 0;\n            for (int dr = -1; dr <= 1; ++dr) {\n                for (int dc = -1; dc <= 1; ++dc) {\n                    int r = row + dr, c = col + dc;\n                    if ((dr != 0 || dc != 0) && r >= 0 && r < n && c >= 0 && c < m &&\n                        grid[r][c] == '#') {\n                        ++count;\n                    }\n                }\n            }\n            cout << count;\n        }\n        cout << '\\n';\n    }\n    return 0;\n}\n"
